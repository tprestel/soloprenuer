{
  "manifest_version": 3,
  "name": "FreshTab — Beautiful New Tab",
  "version": "0.1.0",
  "description": "A beautiful new tab with time, weather, daily focus, and inspiring backgrounds. Everything free, no account needed.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openweathermap.org/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
